# =====================================================================
# Plantilla de variables de entorno para docker-compose.
# Copiar a `.env` (que NO se versiona) y ajustar los valores.
#   cp .env.example .env
# =====================================================================

# ---- PostgreSQL ----
# Credenciales y nombre de la base. En produccion, cambiar la contraseña.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wayni_bcra

# Connection string que usan la API y el Worker (apunta al servicio `postgres` del compose).
# Tiene mayor prioridad que appsettings.json (sobrescribe la config base).
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=wayni_bcra;Username=postgres;Password=postgres

# ---- AWS / LocalStack ----
# Endpoint de LocalStack (servicio `localstack` del compose). En AWS real se deja vacio.
Aws__ServiceUrl=http://localstack:4566
Aws__Region=us-east-1
Aws__BucketName=wayni-bcra-imports
Aws__QueueName=wayni-bcra-import-queue

# Credenciales AWS. Para LocalStack son dummy (acepta cualquier valor); "test"/"test" es la convencion.
# En AWS real, usar credenciales reales fuera del repo.
Aws__AccessKey=test
Aws__SecretKey=test

# ---- Frontend / CORS ----
# URL de la API vista desde el NAVEGADOR del usuario (host), no desde la red interna de Docker.
# El navegador llega a la API por el puerto publicado, por eso localhost:8080.
VITE_API_URL=http://localhost:8080

# Origenes permitidos por CORS en la API (separados por coma). El frontend (Vite) corre en :5173.
Cors__AllowedOrigins__0=http://localhost:5173

# ---- SMTP / Notificaciones (Mailpit) ----
# El NotificationWorker envia la notificacion de fin de importacion por SMTP a Mailpit.
# Los emails capturados se ven en la UI de Mailpit: http://localhost:8025
Smtp__Host=mailpit
Smtp__Port=1025
Smtp__FromAddress=no-reply@wayni-bcra.local
Smtp__FromName=Wayni BCRA
Smtp__ToAddress=ops@wayni-bcra.local

# ---- Parametros de la cola (usados por el script de init de LocalStack) ----
AWS_BUCKET_NAME=wayni-bcra-imports
AWS_QUEUE_NAME=wayni-bcra-import-queue
AWS_DLQ_NAME=wayni-bcra-import-dlq
AWS_MAX_RECEIVE_COUNT=3
AWS_VISIBILITY_TIMEOUT=900
